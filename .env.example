DATABASE_URL=mysql://user:password@host:3306/letters
# Admin login: username + password (password at least 16 characters)
ADMIN_USERNAME=admin
ADMIN_TOKEN=long-random-string-at-least-16-chars
IP_SALT=another-long-random-string
WEB_ORIGIN=https://your-site.com
PORT=5100
# Comma-separated words that block a letter from being posted
BLOCKED_WORDS=
# Set to 1 when the API runs behind a proxy (Render, Railway, nginx) so rate limits see real IPs
TRUST_PROXY=
# Letters one person can post per hour (0 = no limit)
POSTS_PER_HOUR=5

# Translation (optional): fill in ONE of these to show a "Translate" button on letters and replies.
# Readers can then translate into every language the service supports. Leave all empty to turn translation off.
# DeepL: free plan = 500,000 characters/month, key ends in ":fx"  https://www.deepl.com/pro-api
DEEPL_API_KEY=
# Google Cloud Translation (the most languages): https://cloud.google.com/translate
GOOGLE_TRANSLATE_API_KEY=
# LibreTranslate, free if you host it yourself: https://libretranslate.com
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# Most characters the translation service may be asked to translate per calendar month (0 = no limit).
# Keep it below your service's free allowance (DeepL Free and Google both give about 500,000). When it's used up,
# readers see "Translation is resting until next month" and nothing is billed.
TRANSLATE_MONTHLY_LIMIT=400000
