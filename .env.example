DATABASE_URL=mysql://user:password@host:3306/letters
ADMIN_TOKEN=long-random-string-at-least-16-chars
IP_SALT=another-long-random-string
WEB_ORIGIN=https://your-site.com
PORT=4100
# Comma-separated words that block a letter from being posted
BLOCKED_WORDS=
# Set to 1 when the API runs behind a proxy (Render, Railway, nginx) so rate limits see real IPs
TRUST_PROXY=
